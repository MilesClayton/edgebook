EDGEBOOK_EXECUTION_ENABLED=false
EDGEBOOK_EXECUTION_ENVIRONMENT=demo
EDGEBOOK_EXECUTION_TOPOLOGY=single_host_durable_sqlite
EDGEBOOK_EXECUTION_DURABLE_MOUNT=/data
EDGEBOOK_EXECUTION_HOST_ID=YOUR_EXISTING_FLY_MACHINE_ID
EDGEBOOK_EXECUTION_DIRECT_MEMBER=false
EDGEBOOK_EXECUTION_SUBACCOUNT=0
EDGEBOOK_EXECUTION_KALSHI_KEY_ID=YOUR_EXECUTION_KEY_ID
EDGEBOOK_EXECUTION_KALSHI_PRIVATE_KEY_PATH=/path/to/execution-key.pem
EDGEBOOK_EXECUTION_API_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_OPERATOR_SECRET
EDGEBOOK_EXECUTION_PROPOSAL_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_PROPOSAL_SECRET
EDGEBOOK_EXECUTION_PURCHASE_SPEND_CENTS=500
EDGEBOOK_EXECUTION_OPEN_EXPOSURE_CENTS=300
EDGEBOOK_EXECUTION_REALIZED_LOSS_CENTS=300
EDGEBOOK_EXECUTION_ORDER_DEBIT_CENTS=100
EDGEBOOK_EXECUTION_MAX_CONTRACTS=1
EDGEBOOK_EXECUTION_MIN_EDGE=0.04
EDGEBOOK_EXECUTION_LATENCY_BUFFER=0.01
EDGEBOOK_EXECUTION_EXIT_ADVANTAGE=0.005
EDGEBOOK_EXECUTION_MIN_MODEL_CONFIDENCE=0.7
EDGEBOOK_EXECUTION_JEV_MODEL=typesafe-ai/jev
# Long-shot pilot (switched on from the popup; off by default)
EDGEBOOK_EXECUTION_LONGSHOT_CONTRACTS=1.00
EDGEBOOK_EXECUTION_LONGSHOT_MAX_ORDERS=5
EDGEBOOK_EXECUTION_LONGSHOT_EVENT_CENTS=500
EDGEBOOK_EXECUTION_LONGSHOT_EXPIRE_S=900
