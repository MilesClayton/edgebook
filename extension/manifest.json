{
  "manifest_version": 3,
  "name": "Edgebook",
  "version": "0.4.2",
  "description": "Budget-based Kalshi trading controls, Jev automation, live positions and market data.",
  "action": {
    "default_title": "Open persistent Edgebook controls"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://dashboard-ten-murex-53tctwc6fk.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [{
    "resources": ["popup.html"],
    "matches": ["https://kalshi.com/*", "https://*.kalshi.com/*"]
  }],
  "content_scripts": [
    {
      "matches": [
        "https://kalshi.com/*",
        "https://*.kalshi.com/*"
      ],
      "js": [
        "kalshi-core.js",
        "kalshi.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
